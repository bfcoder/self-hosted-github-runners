# Org-level runners:
GITHUB_URL=https://github.com/my-org
# ...or repo-level runners:
# GITHUB_URL=https://github.com/my-org/my-repo

# Classic PAT with `admin:org` (org runners) or `repo` (repo runners) scope.
# Fine-grained PAT alternative: "Self-hosted runners" -> Read and write.
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

RUNNER_REPLICAS=3
RUNNER_NAME_PREFIX=docker-runner
RUNNER_LABELS=self-hosted,linux,docker
RUNNER_GROUP=Default

# true  = runner takes exactly one job, then the container restarts fresh (recommended)
# false = long-lived runner, state carries between jobs
RUNNER_EPHEMERAL=true

# Optional: pin the actions/runner release instead of taking the latest.
# RUNNER_VERSION=2.328.0
