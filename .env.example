# Org-level runners:
GITHUB_URL=https://github.com/CHANGE-ME-org
# ...or repo-level runners:
# GITHUB_URL=https://github.com/CHANGE-ME-org/CHANGE-ME-repo

# Classic PAT scope: `admin:org` for org runners, `repo` for repo runners.
# Fine-grained PAT, resource owner = that org or user:
#   org runners:  Organization permissions -> Self-hosted runners -> Read and write
#   repo runners: Repository permissions   -> Administration      -> Read and write
GITHUB_PAT=CHANGE-ME

# Optional: point individual runners somewhere else. A runner registers to one
# org or one repo, so to serve an org AND a personal repo from this stack, give
# some runners their own target. Unset = use GITHUB_URL / GITHUB_PAT above.
# A fine-grained PAT has a single resource owner, so a personal repo needs its
# own PAT; a classic PAT with admin:org + repo could be reused for both.
# GITHUB_URL_5=https://github.com/CHANGE-ME-user/CHANGE-ME-private-repo
# GITHUB_PAT_5=CHANGE-ME

# Runners are named "<prefix>-1", "<prefix>-2", ... (set per service in
# docker-compose.yml, because each runner shares its daemon's hostname).
RUNNER_NAME_PREFIX=docker-runner

# Match these in your workflow's `runs-on:`.
RUNNER_LABELS=self-hosted,linux,x64,docker

# Org runner groups only; ignored for runners whose target is a repo.
RUNNER_GROUP=Default

# true  = one job per container, then it restarts clean (what hosted does)
# false = long-lived runner, registration reused
RUNNER_EPHEMERAL=true

# true = wipe the work tree on every container start, so each job starts from an
# empty workspace like a fresh hosted VM. false = keep it, so actions/checkout
# does an incremental fetch instead of a full clone (faster, less faithful).
FRESH_WORKSPACE=true

# Per-runner resource limits. A GitHub-hosted runner is 4 vCPU / 16 GB; these
# default to the same so builds are sized the way workflows expect. Without
# them a container sees the whole host and cargo/make/jest fan out to every
# core in every runner at once.
#
# Memory is a HARD CAP per runner. Five runners x 16g needs 80 GB of host RAM
# if they are all busy; size these to your host or run fewer runners.
RUNNER_CPUS=4
RUNNER_MEMORY=16g

# Per-job memory sampling. Logs usage bands, kernel OOM kills and a peak
# summary to `docker compose logs runner-N`. A compiler killed by the kernel
# reports no error of its own, so without this a build just fails silently.
MEM_SAMPLE=true
MEM_SAMPLE_INTERVAL=5

# Docker-in-Docker image, one daemon per runner. Pinned deliberately: dind
# major versions change defaults.
DIND_IMAGE=docker:28-dind

# Optional: pin the actions/runner release. Empty = latest at build time.
RUNNER_VERSION=

# --- weekly prune (cache-cleanup service) ---------------------------------
# Toolchains and image layers untouched for this many days are removed.
CACHE_MAX_AGE_DAYS=14
# 604800 = 7 days. The timer starts when the container starts.
CACHE_PRUNE_INTERVAL_SECONDS=604800
# Set true to log what would be deleted without deleting it.
CACHE_PRUNE_DRY_RUN=false
# Prune each dind's image/layer store as well as the tool caches.
CACHE_PRUNE_DOCKER=true
DIND_HOSTS=tcp://dind-1:2375,tcp://dind-2:2375,tcp://dind-3:2375,tcp://dind-4:2375,tcp://dind-5:2375
