# Org-level runners:
GITHUB_URL=https://github.com/CHANGE-ME-org
# ...or repo-level runners:
# GITHUB_URL=https://github.com/CHANGE-ME-org/CHANGE-ME-repo

# Classic PAT scope: `admin:org` for org runners, `repo` for repo runners.
# Fine-grained PAT: "Self-hosted runners" -> Read and write.
GITHUB_PAT=CHANGE-ME

# Each replica names itself "<prefix>-<container hostname>".
RUNNER_NAME_PREFIX=docker-runner

# Match these in your workflow's `runs-on:`.
RUNNER_LABELS=self-hosted,linux,x64,docker

# Org runner groups only; leave as Default for repo-level runners.
RUNNER_GROUP=Default

# true  = one job per container, then it restarts clean (what hosted does)
# false = long-lived runner, registration reused
RUNNER_EPHEMERAL=true

# true = wipe the work tree on every container start, so each job starts from an
# empty workspace like a fresh hosted VM. false = keep it, so actions/checkout
# does an incremental fetch instead of a full clone (faster, less faithful).
FRESH_WORKSPACE=true

# Docker-in-Docker image, one daemon per runner. Pinned deliberately: dind
# major versions change defaults.
DIND_IMAGE=docker:28-dind

# Optional: pin the actions/runner release. Empty = latest at build time.
RUNNER_VERSION=

# --- weekly prune (cache-cleanup service) ---------------------------------
# Toolchains and image layers untouched for this many days are removed.
CACHE_MAX_AGE_DAYS=14
# 604800 = 7 days. The timer starts when the container starts.
CACHE_PRUNE_INTERVAL_SECONDS=604800
# Set true to log what would be deleted without deleting it.
CACHE_PRUNE_DRY_RUN=false
# Prune each dind's image/layer store as well as the tool caches.
CACHE_PRUNE_DOCKER=true
DIND_HOSTS=tcp://dind-1:2375,tcp://dind-2:2375,tcp://dind-3:2375
